	column 'Price Gap' = IF ( NOT ISBLANK ( phones[product_original_price] ) && NOT ISBLANK ( phones[product_minimum_offer_price] ), phones[product_original_price] - phones[product_minimum_offer_price] )
		dataType: double
		formatString: \$#,0.00
		lineageTag: 94bcc604-90fa-4856-8f73-4b3a8a3960b8
		summarizeBy: none

	column 'Price Gap %' = DIVIDE ( phones[Price Gap], phones[product_original_price] )
		dataType: double
		formatString: 0.0%
		lineageTag: c17554f0-73b0-49d1-9f3e-f0e41961d248
		summarizeBy: none

	column Badge = SWITCH ( TRUE(), phones[is_best_seller] && phones[is_amazon_choice], "Both", phones[is_best_seller], "Best Seller", phones[is_amazon_choice], "Amazon's Choice", "Regular" )
		dataType: string
		lineageTag: ffce5f9e-0506-4027-8a11-f659c61855c8
		summarizeBy: none

	column 'Prime Label' = IF ( phones[is_prime], "Prime", "Non-Prime" )
		dataType: string
		lineageTag: 0c1c1940-1ab1-4d49-a68e-5a365d9b9031
		summarizeBy: none

	column 'Climate Label' = IF ( phones[climate_pledge_friendly], "Climate Friendly", "Not Climate Friendly" )
		dataType: string
		lineageTag: 39e7d53a-42e1-49fa-895a-01a90bbcfdd4
		summarizeBy: none

	column 'Price Band' = IF ( ISBLANK ( phones[product_price] ), "Unknown", IF ( phones[product_price] < 100, "Under $100", IF ( phones[product_price] < 250, "$100-$249", IF ( phones[product_price] < 500, "$250-$499", "$500+" ) ) ) )
		dataType: string
		lineageTag: c50d6fb6-5fba-46da-b23d-bb9da79f949c
		summarizeBy: none
		sortByColumn: 'Price Band Order'

	column 'Price Band Order' = IF ( ISBLANK ( phones[product_price] ), 5, IF ( phones[product_price] < 100, 1, IF ( phones[product_price] < 250, 2, IF ( phones[product_price] < 500, 3, 4 ) ) ) )
		dataType: int64
		formatString: 0
		lineageTag: 4ca15ce3-79c7-4846-8441-1e29929b16b6
		summarizeBy: none

	partition phones = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CsvPath), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Dedup = Table.Distinct(Promoted, {"asin"}),
				    CleanPrice = (t as nullable text) as nullable number => try Number.FromText(Text.Trim(Text.Replace(t, "$", "")), "en-US") otherwise null,
				    Prices = Table.TransformColumns(Dedup, {{"product_price", CleanPrice, type number}, {"product_original_price", CleanPrice, type number}, {"product_minimum_offer_price", CleanPrice, type number}}),
				    Title = Table.TransformColumns(Prices, {{"product_title", each Text.Replace(Text.Replace(_, "&amp;", "&"), "&quot;", """"), type text}}),
				    Sales = Table.AddColumn(Title, "sales_volume_num", each let s = [sales_volume] in if s <> null and Text.Contains(s, "bought in past month") then (let t = Text.BeforeDelimiter(s, "+") in if Text.EndsWith(t, "K") then Number.FromText(Text.TrimEnd(t, "K"), "en-US") * 1000 else Number.FromText(t, "en-US")) else null, Int64.Type),
				    Types = Table.TransformColumnTypes(Sales, {{"product_star_rating", type number}, {"product_num_ratings", Int64.Type}, {"product_num_offers", Int64.Type}, {"is_best_seller", type logical}, {"is_amazon_choice", type logical}, {"is_prime", type logical}, {"climate_pledge_friendly", type logical}, {"has_variations", type logical}}, "en-US"),
				    Currency = Table.ReplaceValue(Types, null, "USD", Replacer.ReplaceValue, {"currency"}),
				    Coupon = Table.ReplaceValue(Currency, null, "No coupon", Replacer.ReplaceValue, {"coupon_text"}),
				    Avail = Table.ReplaceValue(Coupon, null, "Not specified", Replacer.ReplaceValue, {"product_availability"}),
				    Dropped = Table.RemoveColumns(Avail, {"unit_price", "unit_count"}),
				    Final = Table.SelectColumns(Dropped, {"asin","product_title","product_price","product_original_price","currency","product_star_rating","product_num_ratings","product_num_offers","product_minimum_offer_price","is_best_seller","is_amazon_choice","is_prime","product_availability","climate_pledge_friendly","sales_volume","delivery","has_variations","coupon_text","sales_volume_num"})
				in
				    Final

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

