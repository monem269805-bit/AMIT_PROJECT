table phones
	lineageTag: d3bc8b31-9386-4728-a3fa-7695624d8afd

	measure 'Product Count' = DISTINCTCOUNT ( phones[asin] )
		formatString: #,0
		lineageTag: c4932de9-d4fd-40fa-a78e-8a8cd247b449

	measure 'Avg Product Price' = AVERAGE ( phones[product_price] )
		formatString: \$#,0.00
		lineageTag: 67921829-a147-48ea-9e18-f2878009eb46

	measure 'Avg Original Price' = AVERAGE ( phones[product_original_price] )
		formatString: \$#,0.00
		lineageTag: 7e192333-71f3-4b48-b94e-d252a275ec67

	measure 'Avg Min Offer Price' = AVERAGE ( phones[product_minimum_offer_price] )
		formatString: \$#,0.00
		lineageTag: 81088a2e-7108-4c31-8f2d-1610d1ff20e8

	measure 'Avg Price Gap' = AVERAGE ( phones[Price Gap] )
		formatString: \$#,0.00
		lineageTag: bcc029c8-c134-4562-b499-0008d068b985

	measure 'Avg Star Rating' = AVERAGE ( phones[product_star_rating] )
		formatString: 0.00
		lineageTag: adb15e1c-b9bd-4900-8b66-a008e2a40740

	measure 'Total Sales Volume' = SUM ( phones[sales_volume_num] )
		formatString: #,0
		lineageTag: 01c4a7ec-c435-4e23-b537-04dce422417e

	measure 'Sales per Product' = DIVIDE ( [Total Sales Volume], [Product Count] )
		formatString: #,0.0
		lineageTag: fd65bce5-1376-4b81-9319-791f9269b39d

	measure 'Number of Offers' = SUM ( phones[product_num_offers] )
		formatString: #,0
		lineageTag: 6e67e93d-4548-49aa-9847-6e088edb1da6

	measure 'Best Sellers Count' = CALCULATE ( COUNTROWS ( phones ), phones[is_best_seller] = TRUE() )
		formatString: #,0
		lineageTag: 8d783aaf-25e4-4655-942b-59c4a8be1eb5

	measure 'Amazon Choice Count' = CALCULATE ( COUNTROWS ( phones ), phones[is_amazon_choice] = TRUE() )
		formatString: #,0
		lineageTag: 0a02f0bf-0503-4f49-91c0-1450bfc6af19

	measure 'Prime %' = DIVIDE ( CALCULATE ( COUNTROWS ( phones ), phones[is_prime] = TRUE() ), COUNTROWS ( phones ) )
		formatString: 0.0%
		lineageTag: 3ce38af0-0a0d-4454-9966-d11f0337e986

	measure 'Climate Friendly %' = DIVIDE ( CALCULATE ( COUNTROWS ( phones ), phones[climate_pledge_friendly] = TRUE() ), COUNTROWS ( phones ) )
		formatString: 0.0%
		lineageTag: b0b8ed65-98db-489b-9a39-0e0b3ff3327d

	measure 'Est. Revenue' = SUMX ( phones, phones[product_price] * phones[sales_volume_num] )
		formatString: \$#,0
		lineageTag: f9939928-8040-465c-b825-47d8bd58b9ea

